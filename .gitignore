# ------------------------------------------------------------------- build out
dist/
build/
out/
.vite/
*.tsbuildinfo
.eslintcache
.cache/
.parcel-cache/

# ------------------------------------------------------- runtime evidence/logs
# Raw model output written by the server on every duel, and the browser profile
# `pnpm verify` keeps your provider settings in. Both are regenerated by using
# the app; neither belongs in the repo.
server/logs/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.bpd-browser/

# ------------------------------------------------------------------ env/secret
# This project needs no .env file — configuration lives in the app's Settings
# panel and in your browser's localStorage, and `pnpm verify` asserts that no
# .env or .env.example exists anywhere. These are ignored so that anyone who
# reaches for one out of habit cannot commit it by accident.
.env
.env.*

